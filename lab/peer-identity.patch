--- a/uet.c
+++ b/uet.c
@@ -577,0 +578,28 @@
+
+	/* Demo application only: configure the peer's advertised identity.
+	 * The UET library and the NIC shim are unchanged.
+	 */
+	const char *peer_identity = getenv("UET_PEER_IDENTITY");
+	if (peer_identity != NULL) {
+		unsigned long values[3];
+		const char *cursor = peer_identity;
+		for (int field = 0; field < 3; field++) {
+			char *end;
+			errno = 0;
+			values[field] = strtoul(cursor, &end, 10);
+			if (errno || end == cursor ||
+			    *end != (field == 2 ? '\0' : ':')) {
+				UET_ERR("UET_PEER_IDENTITY must be PID:RI:INITIATOR");
+				return UET_ERR_RC;
+			}
+			cursor = end + (field != 2);
+		}
+		if (values[0] > UINT16_MAX || values[1] > UINT16_MAX ||
+		    values[2] > UINT32_MAX) {
+			UET_ERR("UET_PEER_IDENTITY field out of range");
+			return UET_ERR_RC;
+		}
+		addr->pid_on_fep = (uint16_t)values[0];
+		addr->start_index = (uint16_t)values[1];
+		addr->initiator_id = (uint32_t)values[2];
+	}
